rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /ros/{id} {
      allow read, write: if request.auth.uid == "heEO6l4moPcnKoOmvgUlDAptSfX2";
    }
    match /meta/{id} {
      allow read, write: if request.auth.uid == "heEO6l4moPcnKoOmvgUlDAptSfX2";
    }
  }
}
